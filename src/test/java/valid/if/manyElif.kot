int main()
{
    if(1 < 0)
    {
        print("There is an error on 1 < 0");
        return 8;
    }
    elif (1 < -1)
    {
        print("There is an error on 1 < -1");
        return 8;
    }
    elif (10 < 5)
    {
        print("There is an error on 10 < 5");
        return 8;
    }
    elif (80 < 100)
    {
        print("Yes 80 < 100");
        return 0;
    }
    elif(60 < 50)
    {
        print("There is an error on 60 < 50");
        return 8;
    }
    else
    {
        print("There is an error one elif is right");
        return 8;
    };
    print("There is an error on 0 < 1");
    return 8;
};
